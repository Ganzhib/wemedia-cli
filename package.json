{
  "name": "@ganzhibin/wemedia-cli",
  "version": "0.2.0-alpha.2",
  "description": "AI-native multi-platform publishing CLI for Juejin, Xiaohongshu and WeChat",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "wm": "dist/wm.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "scripts/postinstall.mjs",
    "docs",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ganzhib/wemedia-cli.git"
  },
  "homepage": "https://github.com/Ganzhib/wemedia-cli#readme",
  "bugs": {
    "url": "https://github.com/Ganzhib/wemedia-cli/issues"
  },
  "keywords": [
    "wemedia",
    "cli",
    "agent",
    "wechat",
    "xiaohongshu",
    "juejin",
    "markdown"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.contracts.json",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/wm.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "build:site": "node scripts/build-site.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepare": "npm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "npm run build",
    "test:browser": "tsx --test test/browser/*.test.ts"
  },
  "dependencies": {
    "@wenyan-md/core": "3.0.6",
    "commander": "^14.0.0",
    "dompurify": "3.4.17",
    "form-data-encoder": "4.1.0",
    "formdata-node": "6.0.3",
    "gray-matter": "^4.0.3",
    "jsdom": "27.4.0",
    "json-bigint": "^1.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-to-markdown": "^2.1.2",
    "playwright": "^1.56.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "27.0.0",
    "@types/json-bigint": "^1.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
